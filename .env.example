# ==============================================================================
# CAMPUSFIX - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string (supports Neon, Supabase, Render, Railway, AWS RDS)
# Example: postgresql://postgres:YOUR_PASSWORD@ep-xyz.region.aws.neon.tech/campusfix?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusfix?schema=public"

# Direct URL for Prisma migrations when using connection poolers (e.g. Supabase pgbouncer)
# Leave identical to DATABASE_URL if connection pooling is not used
DIRECT_URL="postgresql://postgres:password@localhost:5432/campusfix?schema=public"

# ------------------------------------------------------------------------------
# 2. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens and authentication session cookies
# In production, generate a strong random 64-character secret
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-in-production"

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Fully qualified domain of the deployed frontend/app for strict CORS enforcement
# Example: https://campusfix.yourcollege.edu
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR PROVISIONING (Optional, for npm run admin:create)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword123!"
ADMIN_NAME="Campus Facilities Director"
ADMIN_DEPARTMENT="Campus Operations"
