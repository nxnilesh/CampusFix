# ==============================================================================
# CAMPUSFIX - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# For Neon, use the pooled endpoint for DATABASE_URL and the direct endpoint for DIRECT_URL.
# Set sslmode=require and connect_timeout=30 on both. Add pgbouncer=true and
# connection_limit=5 to the pooled URL.
# Example: postgresql://postgres:YOUR_PASSWORD@ep-xyz.region.aws.neon.tech/campusfix?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusfix?schema=public"

# Direct URL used by Prisma migrations; do not point this at a transaction pooler.
DIRECT_URL="postgresql://postgres:password@localhost:5432/campusfix?schema=public"

# ------------------------------------------------------------------------------
# 2. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens and authentication session cookies
# In production, generate a strong random 64-character secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-in-production"

# Backend email delivery (Sendpository)
SENDPOSITORY_API_KEY=
# Use the dashboard sandbox sender only for tests to your confirmed account email.
# For other recipients, use an address on a verified domain; SPF, DKIM and the
# Return-Path MX records are required by Sendpository (DMARC is recommended).
SENDPOSITORY_FROM_EMAIL=

# JWT token expiry (default: 7d) — adjust for stricter security
# TOKEN_EXPIRY="7d"

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Fully qualified domain of the deployed frontend/app for strict CORS enforcement
# Example: https://campusfix.yourcollege.edu
CORS_ORIGIN="http://localhost:3000"
# Public app URL used in resolver approval emails (defaults to CORS_ORIGIN).
CAMPUSFIX_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR PROVISIONING (for npm run admin:create)
# ------------------------------------------------------------------------------
# IMPORTANT: Change these before running admin:create in production.
# Admin panel is accessible at /admin-panel (not linked publicly).
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword123!"
ADMIN_NAME="Campus Facilities Director"
ADMIN_DEPARTMENT="Campus Operations"

# ------------------------------------------------------------------------------
# 5. RATE LIMITING (optional overrides — defaults are in server.ts)
# ------------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000     # Window size in milliseconds (default: 60s)
# RATE_LIMIT_MAX_AUTH=10         # Max auth requests per window per IP (default: 10)
# RATE_LIMIT_MAX_GLOBAL=200      # Max global API requests per window per IP (default: 200)

# ------------------------------------------------------------------------------
# 6. DEPLOYMENT SECURITY CHECKLIST
# ------------------------------------------------------------------------------
# Before going to production:
# [ ] Set NODE_ENV=production
# [ ] Set a strong SESSION_SECRET (64+ chars)
# [ ] Set CORS_ORIGIN to your actual domain
# [ ] Enable HTTPS on your host (Render, Railway, Vercel, etc. do this automatically)
# [ ] Remove all test/seed accounts from the database
# [ ] Confirm admin account is created via npm run admin:create
# [ ] Review firewall rules — only expose port 443 (HTTPS) publicly
# [ ] Set up automated database backups (daily recommended)
# [ ] Monitor failed login attempts in ActivityLog table
